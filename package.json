{
  "name": "tabletop-conduit",
  "version": "0.2.39",
  "description": "Conduit — a bridge between your character sheets (D&D Beyond, poke5e, monsters) and your virtual tabletop.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist-electron/main.js",
  "comment:overrides": "Force electron-builder's deep dep @electron/get up to v5 (what electron itself already uses) — v3 dragged in the deprecated global-agent → roarr@2 → sprintf-js@1.1.3 chain (CVE-2026-97058, a dev-only DoS with no upstream patch). v5 dropped global-agent, severing it.",
  "overrides": {
    "@electron/get": "^5.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:poke5e": "tsx scripts/check-poke5e-compat.ts",
    "shell:build": "node scripts/build-electron.mjs",
    "shell": "npm run shell:build && electron .",
    "pack": "npm run shell:build && electron-builder --dir",
    "dist": "npm run shell:build && electron-builder",
    "dist:mac": "npm run shell:build && electron-builder --mac",
    "dist:win": "npm run shell:build && electron-builder --win",
    "verify:release": "node scripts/verify-release.mjs",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "com.hwest.conduit",
    "productName": "Conduit",
    "afterPack": "scripts/afterpack-fuses.mjs",
    "publish": [
      {
        "provider": "github",
        "owner": "dr0v3rr",
        "repo": "tabletop-conduit"
      }
    ],
    "files": [
      "dist-electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableName": "conduit",
      "category": "Game",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@types/node": "^22.20.1",
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
